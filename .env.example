# Postgres (required for persistent mode). Local default matches docker-compose.yml
DATABASE_URL="postgresql://freshmint:freshmint@127.0.0.1:5433/freshmint?schema=public"
# On Vercel + Prisma Postgres: keep the marketplace DATABASE_URL from the Prisma
# integration. Runtime uses @prisma/adapter-ppg (HTTP) for *.prisma.io hosts so
# serverless traffic does not exhaust the tiny direct TCP / prisma_migration budget.

AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_NAME="FreshMint Marketplace"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional). Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# testnet (default) | mainnet — flip when wallets are funded
# USD → native quotes. Buy/prepare fetch CoinGecko (ETH + SOL) first; these are fallbacks.
# NEXT_PUBLIC_USD_PER_ETH="3000"
# NEXT_PUBLIC_USD_PER_SOL="150"
# NEXT_PUBLIC_USD_PER_BOING="1"

NEXT_PUBLIC_CHAIN_MODE="testnet"
NEXT_PUBLIC_RELAY_SOURCE="freshmint.marketplace"

# Object storage (Vercel Blob). Without this, uploads go to public/uploads locally.
# BLOB_READ_WRITE_TOKEN=

# --- Platform fees (0.5% treasury on every primary sale) ---
# Buyer pays listed price; seller receives 99.5%.
# Featured boost ($15 USD) also pays these public treasury addresses in native.
# EVM + Solana are used by checkout / featured boost settlement today.
# BTC is recorded for ops / future payouts (no Bitcoin settlement path yet).
NEXT_PUBLIC_PLATFORM_TREASURY_ADDRESS="0xDde8Ec0A27467a8Eb6E7a3245e07d2D67B6B56bb"
NEXT_PUBLIC_PLATFORM_TREASURY_SOLANA="3u2DbBkCqoSQmcreHfwQWDekJ8HPctgns3v6L3LdupwW"
NEXT_PUBLIC_PLATFORM_TREASURY_BTC="bc1q27glxg2fr0f3jrl6m3vyy3ynuaclzwd4ya7jxq"
# NEXT_PUBLIC_PLATFORM_OPERATOR_ADDRESS="0x..."   # optional leftover EOA (constructor / setFeeRecipients)
# NEXT_PUBLIC_PLATFORM_OPERATOR_SOLANA="..."      # optional leftover Solana pubkey
# Require live RPC receipt before activating Featured boost (recommended in prod)
# FEATURED_BOOST_REQUIRE_CONFIRM="true"

# --- EVM ERC-721 markets (one deploy per network) ---
# NEXT_PUBLIC_EVM_MARKET_ADDRESS_ETHEREUM="0x..."
# NEXT_PUBLIC_EVM_MARKET_ADDRESS_BASE="0x..."
# NEXT_PUBLIC_EVM_MARKET_ADDRESS_ARBITRUM="0x..."
# NEXT_PUBLIC_EVM_MARKET_ADDRESS_OPTIMISM="0x..."
# Legacy single-address fallback (maps to ethereum):
# NEXT_PUBLIC_EVM_MARKET_ADDRESS="0x..."

# EVM_RPC_URL_ETHEREUM="https://ethereum-sepolia-rpc.publicnode.com"
# EVM_RPC_URL_BASE="https://sepolia.base.org"
# EVM_RPC_URL_ARBITRUM="https://sepolia-rollup.arbitrum.io/rpc"
# EVM_RPC_URL_OPTIMISM="https://sepolia.optimism.io"
# Legacy:
# EVM_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
# Optional server-side minter:
# EVM_MINTER_PRIVATE_KEY="0x..."

# --- Solana (Metaplex Core by default; set SOLANA_MINT_MODE=memo for attestation fallback) ---
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
# SOLANA_RPC_URL="https://api.devnet.solana.com"
# SOLANA_MINTER_SECRET_KEY="[1,2,3,...]"  # JSON byte array
# SOLANA_MINT_MODE="metaplex"
# SOLANA_REQUIRE_CONFIRM="false"
# RELAY_SOLANA_CHAIN_ID="792703809"

# --- Boing Testnet (native L1, not EVM; Boing Express wallet) ---
# Public gateway is Cloudflare-fronted. Runtime sends a User-Agent and falls back to
# Fly origins when the edge returns 403/HTML. Prefer an allowlisted URL in production:
# BOING_RPC_URL="https://boing-testnet-1.fly.dev/"
# Optional comma-separated extras (tried after BOING_RPC_URL / default):
# BOING_RPC_FALLBACK_URLS="https://boing-testnet-2.fly.dev/"
# Set to 1 to skip built-in Fly fallbacks (only use BOING_RPC_URL + FALLBACK_URLS):
# BOING_RPC_DISABLE_DEFAULT_FALLBACKS="1"
# NEXT_PUBLIC_BOING_NFT_COLLECTION="0x..."  # 32-byte collection AccountId; omit to deploy a collection
# Optional override for the pinned official NFT template (default is vendored v1):
# BOING_REFERENCE_NFT_COLLECTION_TEMPLATE_BYTECODE_HEX="0x..."
# v3 mint_batch (0x06, n≤500) dump line 3 — preferred for new collection deploys:
# BOING_REFERENCE_NFT_COLLECTION_TEMPLATE_V3_BYTECODE_HEX="0x..."
# Stale v2 key (n≤50 historically). FreshMint prefers V3; keep V2 only for stamped "2" heal/fallback:
# BOING_REFERENCE_NFT_COLLECTION_TEMPLATE_V2_BYTECODE_HEX="0x..."
# BOING_REFERENCE_NFT_COLLECTION_TEMPLATE_VERSION="3"

# ALLOW_DEMO_AUTH="true"

# --- Wallet NFT inventory on /me (optional; Reservoir is used without a key) ---
# ALCHEMY_API_KEY=
# RESERVOIR_API_KEY=
# HELIUS_API_KEY=


# --- Cron (Vercel Cron → Authorization: Bearer ${CRON_SECRET}) ---
# Required for /api/cron/settle-auctions (daily English settle + payment cascade).
# Generate a long random string and set the same value in Vercel Project → Settings → Environment Variables.
# CRON_SECRET="replace-with-a-long-random-secret"

# --- Transactional email (Resend) — English win / expired awards only ---
# RESEND_API_KEY=
# EMAIL_FROM="FreshMint <noreply@your-domain.com>"

# --- Sentry (optional) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
