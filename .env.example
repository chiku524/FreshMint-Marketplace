# Postgres (required for persistent mode). Local default matches docker-compose.yml
DATABASE_URL="postgresql://freshmint:freshmint@127.0.0.1:5433/freshmint?schema=public"
# On Vercel + Prisma Postgres: keep the marketplace DATABASE_URL from the Prisma
# integration. Runtime uses @prisma/adapter-ppg (HTTP) for *.prisma.io hosts so
# serverless traffic does not exhaust the tiny direct TCP / prisma_migration budget.

AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_NAME="FreshMint Marketplace"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional). Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# testnet (default) | mainnet — flip when wallets are funded
# USD → native quotes. Buy/prepare fetch CoinGecko (ETH + SOL) first; these are fallbacks.
# NEXT_PUBLIC_USD_PER_ETH="3000"
# NEXT_PUBLIC_USD_PER_SOL="150"
# NEXT_PUBLIC_USD_PER_BOING="1"

NEXT_PUBLIC_CHAIN_MODE="testnet"
NEXT_PUBLIC_RELAY_SOURCE="freshmint.marketplace"

# Object storage (Vercel Blob). Without this, uploads go to public/uploads locally.
# BLOB_READ_WRITE_TOKEN=

# --- Platform fees (0.5% treasury on every primary sale) ---
# Buyer pays listed price; seller receives 99.5%.
# Featured boost ($15 USD) also pays these public treasury addresses in native.
# EVM + Solana are used by checkout / featured boost settlement today.
# BTC is recorded for ops / future payouts (no Bitcoin settlement path yet).
NEXT_PUBLIC_PLATFORM_TREASURY_ADDRESS="0xDde8Ec0A27467a8Eb6E7a3245e07d2D67B6B56bb"
NEXT_PUBLIC_PLATFORM_TREASURY_SOLANA="3u2DbBkCqoSQmcreHfwQWDekJ8HPctgns3v6L3LdupwW"
NEXT_PUBLIC_PLATFORM_TREASURY_BTC="bc1q27glxg2fr0f3jrl6m3vyy3ynuaclzwd4ya7jxq"
# Boing payout AccountId (0x + 64 hex). Required for platform fee settlement on Boing;
# if unset, checkout falls back to the listing creator's linked Boing wallet.
NEXT_PUBLIC_PLATFORM_TREASURY_BOING="0x33d7e499589aa6bc9d19ead3153e4d75ad398263199380f63397f04a27ef3ed3"
# NEXT_PUBLIC_BOING_LINKED_NFT_TOKEN_REGISTRY documented below under Boing section.
# NEXT_PUBLIC_PLATFORM_OPERATOR_BOING="0x..."
# NEXT_PUBLIC_PLATFORM_OPERATOR_ADDRESS="0x..."   # optional leftover EOA (constructor / setFeeRecipients)
# NEXT_PUBLIC_PLATFORM_OPERATOR_SOLANA="..."      # optional leftover Solana pubkey
# Require live RPC receipt before activating Featured boost (recommended in prod)
# FEATURED_BOOST_REQUIRE_CONFIRM="true"

# --- Boing Testnet (native L1, not EVM; Boing Express wallet) ---
# NEXT_PUBLIC_BOING_LINKED_NFT_TOKEN_REGISTRY="0x..."
# BOING_SDK_REGISTRY_MODULE="boing-sdk"
